# Secret used to seal/verify OAuth tokens (AES-256-GCM). REQUIRED in production.
# Use a long random string, e.g. `openssl rand -base64 48`.
# If unset, an insecure dev fallback is used and a warning is logged.
OAUTH_SECRET=

# --- Single-tenant fallback credentials ------------------------------------
# Set these only if you want the server to work WITHOUT OAuth (local dev or a
# private single-account deployment). For multi-tenant OAuth deployments, leave
# them unset — each user supplies their own credentials at the login page.
#
# Your Iternio/ABRP Planning API key (sent as the X-API-KEY header). Request one
# from contact@iternio.com. The /plan endpoint is billed per successful plan;
# all other endpoints are free.
ABRP_API_KEY=

# Optional: an ABRP user session (sent as X-ABRP-SESSION). Required only for
# user-scoped v2 calls such as listing the vehicles on your account.
ABRP_SESSION=

# Optional: your ABRP user token for the free v1 telemetry endpoint
# (/1/tlm/send). Generate it in the ABRP app under Settings → "Live Data".
ABRP_USER_TOKEN=

# Optional: telemetry token for v2 telemetry (sent as X-TLM-TOKEN).
ABRP_TLM_TOKEN=

# --- Base URL overrides (operator escape hatch) ----------------------------
# Defaults shown; only set to point at a different host.
# ABRP_V2_BASE_URL=https://api.iternio.com/2
# ABRP_V1_BASE_URL=https://api.iternio.com/1
